---
import DetailPage from '../../components/DetailPage.astro';
import { featureDetails, clinicTypes } from '../../data/details';
import { articleTitles } from '../../data/learn';

export function getStaticPaths() {
  return featureDetails.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const titles = await articleTitles();
---
<DetailPage d={d} section={{ name: '功能', path: '/features' }} siblings={featureDetails} articleTitle={d.article ? titles[d.article] : undefined}
  related={{ name: '適合的診所', path: '/clinics', items: clinicTypes }} />

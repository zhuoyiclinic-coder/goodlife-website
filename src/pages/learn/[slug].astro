---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { brand } from '../../data/site';
import { breadcrumb } from '../../data/schema';

export async function getStaticPaths() {
  const all = await getCollection('learn');
  return all.map((a) => ({ params: { slug: a.data.slug }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const path = `/learn/${a.data.slug}`;
const article = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: a.data.title, description: a.data.description, inLanguage: 'zh-Hant-TW',
  dateModified: a.data.updated, datePublished: a.data.updated,
  author: { '@id': brand.url + '/#org' }, publisher: { '@id': brand.url + '/#org' },
  mainEntityOfPage: brand.url + path,
};
const sources = a.data.sources.map((s) => { const [name, url] = s.split('|').map((x) => x.trim()); return { name, url }; });
---
<Base title={a.data.title} description={a.data.description} jsonld={[article, breadcrumb([{ name: '知識庫', path: '/learn' }, { name: a.data.title, path }])]}>
  <article class="section">
    <div class="wrap prose" style="max-width:760px">
      <nav class="crumb" aria-label="麵包屑"><a href="/">首頁</a> / <a href="/learn">知識庫</a></nav>
      <h1>{a.data.title}</h1>
      <p class="updated">更新：{a.data.updated}</p>
      <Content />
      {sources.length > 0 && (
        <aside class="sources">
          <h2>參考資料</h2>
          <ul>{sources.map((s) => <li>{s.url ? <a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a> : s.name}</li>)}</ul>
        </aside>
      )}
    </div>
  </article>
  <Cta />
</Base>
<style>
  .crumb { font-size: .88rem; color: var(--ink-3); margin-bottom: 20px; }
  .crumb a { color: var(--ink-3); }
  .prose :global(h2) { font-size: 1.45rem; margin-top: 2em; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose :global(table) { display: block; overflow-x: auto; margin: 1.2em 0; border: 1px solid var(--line); border-radius: var(--radius-sm); min-width: 0; }
  .prose :global(.updated + p) { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--brand); border-radius: var(--radius-sm); padding: 18px 22px; color: var(--ink); }
  .sources { margin-top: 3em; padding-top: 1.5em; border-top: 1px solid var(--line); font-size: .9rem; }
  .sources h2 { font-size: 1.1rem; }
</style>

---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Shots from '../components/Shots.astro';
import { brand, faqs } from '../data/site';
import { faqSchema, breadcrumb } from '../data/schema';

const title = '資安與個資保護';
const description = 'GoodLife 好境怎麼保護病患個資：每家診所獨立資料庫、連線加密、角色權限逐項設定、重要操作留稽核紀錄。';
const pageFaqs = faqs.filter((f) => /個資/.test(f.q));
const items = [
  { t: '每家診所獨立資料庫', d: '每家診所使用自己的資料庫與網址，資料不和其他診所放在一起，也不會因為別家的問題受影響。' },
  { t: '連線與儲存都加密', d: '瀏覽器到系統全程 HTTPS 加密，資料庫的儲存也經過加密。' },
  { t: '角色權限逐項設定', d: '老闆、店長、醫師、護理師、諮詢師、美容師、櫃台、會計各有權限。每個功能哪些角色能用，可以在權限表逐項打開或關掉。' },
  { t: '資料庫層級的存取控制', d: '權限不只是畫面上把按鈕藏起來。資料庫本身會檢查登入者的角色，不該看到的資料直接讀不到。' },
  { t: '重要操作留稽核紀錄', d: '退費、改價、改金額、作廢等操作，都記下是誰、什麼時間、改了什麼，紀錄只能新增、不能修改。' },
];
---
<Base title={title} description={description} jsonld={[faqSchema(pageFaqs), breadcrumb([{ name: title, path: '/security' }])]}>
  <header class="page-head">
    <div class="wrap">
      <div class="eyebrow">資安與個資</div>
      <h1>病患資料，只屬於你的診所</h1>
      <p class="updated">更新：{brand.updated}</p>
      <p class="answer">GoodLife 好境讓每家診所使用<strong>獨立的資料庫</strong>，連線全程加密，每個角色只能存取工作需要的資料，重要操作都留下無法修改的稽核紀錄。</p>
    </div>
  </header>
  <section class="section tight">
    <div class="wrap">
      <div class="grid c2">
        {items.map((i) => <div class="card"><h2 class="h3">{i.t}</h2><p>{i.d}</p></div>)}
      </div>
    </div>
  </section>
  <Shots items={[{ file: 'perm', caption: '權限設定：每個角色、每個功能可以設成不能用、只能看或可以用' }, { file: 'audit', caption: '稽核軌跡：重要操作的人、時間、改前改後' }]} />
  <section class="section tight">
    <div class="wrap">
      <h2>常見問答</h2>
      <Faq items={pageFaqs} />
    </div>
  </section>
  <Cta title="想看權限表和稽核紀錄長什麼樣子？" body="預約展示時，可以直接看示範診所的權限設定與稽核紀錄畫面。" />
</Base>
<style>
  .h3 { font-family: var(--sans); font-size: 1.15rem; margin-bottom: .35em; }
</style>

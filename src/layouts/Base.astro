---
import '../styles/global.css';
import { brand, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonld?: object[];
  noindex?: boolean;
}
const { title, description, jsonld = [], noindex = false } = Astro.props;
// 建置成 .html 檔時 pathname 會帶 /index.html、.html，正式網址不帶（Vercel cleanUrls）
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, brand.url).href;
const fullTitle = path === '/' ? `${brand.name}｜醫美診所營運管理系統，從預約到月結一套跑完` : `${title}｜${brand.name}`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': brand.url + '/#org',
  name: brand.name,
  alternateName: [brand.nameEn, brand.nameZh, 'GoodLife', '顧德萊'],
  url: brand.url,
  logo: brand.url + '/brand/icon.svg',
  description: brand.description,
};
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': brand.url + '/#site',
  name: brand.name,
  url: brand.url,
  inLanguage: 'zh-Hant-TW',
  publisher: { '@id': brand.url + '/#org' },
};
const schemas = [org, site, ...jsonld];
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={brand.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="zh_TW" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0B2B57" />
  <meta name="color-scheme" content="only light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">跳到主要內容</a>
  <header class="nav">
    <a class="logo" href="/" aria-label={brand.name + ' 首頁'}><img src="/brand/icon.svg" alt="" width="30" height="30" /><b>GoodLife</b><small>顧德萊</small></a>
    <nav class="nav-links" aria-label="主要導覽">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div style="display:flex;gap:8px;align-items:center">
      <a class="btn btn-primary" href="/demo">預約展示</a>
      <span class="nav-menu"><button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="開啟選單">☰</button></span>
    </div>
  </header>
  <nav class="mobile-menu" id="mobile-menu" aria-label="手機選單">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="/faq">常見問答</a>
  </nav>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer-grid">
      <div>
        <a class="logo" href="/" style="display:inline-flex"><img src="/brand/icon.svg" alt="" width="30" height="30" /><b>GoodLife</b><small>顧德萊</small></a>
        <p style="margin-top:10px;max-width:28em">{brand.nameZh}。給台灣自費醫美診所的雲端營運系統。</p>
      </div>
      <div>
        <a href="/features">功能總覽</a>
        <a href="/aesthetic-clinic">醫美診所</a>
        <a href="/pricing">價格</a>
        <a href="/stories/zhuoyi">客戶故事</a>
      </div>
      <div>
        <a href="/security">資安與個資</a>
        <a href="/faq">常見問答</a>
        <a href="/demo">預約展示</a>
        <a href="/llms.txt">llms.txt</a>
      </div>
    </div>
    <div class="wrap" style="margin-top:28px">© 2026 {brand.name}</div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.querySelector('.menu-btn'), menu = document.getElementById('mobile-menu');
      if (btn) btn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach(function (e) { io.observe(e); });
    })();
  </script>
</body>
</html>

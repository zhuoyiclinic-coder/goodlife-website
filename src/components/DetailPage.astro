---
// 功能頁、角色頁、診所類型頁共用的版型
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';
import Shots from './Shots.astro';
import { brand } from '../data/site';
import { faqSchema, breadcrumb } from '../data/schema';
import type { Detail } from '../data/details';

interface Props {
  d: Detail;
  section: { name: string; path: string };
  siblings: { slug: string; short: string }[];
  articleTitle?: string;
  sibsTop?: boolean;   // 業主 2026-11-06：診所類型頁在開頭說明下面也放一排「其他…」按鈕（底部那排保留）
  related?: { name: string; path: string; items: { slug: string; short: string }[] };   // 頁底另一組連結（功能頁 → 適合的診所）
}
const { d, section, siblings, articleTitle, sibsTop, related } = Astro.props;
const others = siblings.filter((s) => s.slug !== d.slug);
const path = `${section.path}/${d.slug}`;
const jsonld = [breadcrumb([section, { name: d.short, path }]), ...(d.faqs.length ? [faqSchema(d.faqs)] : [])];
---
<Base title={d.title} description={d.description} jsonld={jsonld}>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumb" aria-label="麵包屑"><a href="/">首頁</a> / <a href={section.path}>{section.name}</a> / {d.short}</nav>
      <div class="eyebrow">{section.name}</div>
      <h1>{d.title}</h1>
      <p class="updated">更新：{brand.updated}</p>
      <p class="answer">{d.answer}</p>
      {sibsTop && (
        <nav class="sibs-top" aria-label={`其他${section.name}`}>
          <span class="sibs-label">其他{section.name}：</span>
          <ul class="sibs">{others.map((s) => <li><a href={`${section.path}/${s.slug}`}>{s.short}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </header>

  {d.points.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <div class="grid c3">
          {d.points.map((p) => <div class="card"><h2 class="h3">{p.t}</h2><p>{p.d}</p></div>)}
        </div>
      </div>
    </section>
  )}

  {d.day && d.day.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <h2>一天怎麼用</h2>
        <ol class="day">{d.day.map((x) => <li>{x}</li>)}</ol>
      </div>
    </section>
  )}

  {d.shots && <Shots items={d.shots} />}

  <slot />

  {d.faqs.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <h2>常見問答</h2>
        <Faq items={d.faqs} />
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      {d.article && articleTitle && <p class="more">延伸閱讀：<a href={`/learn/${d.article}`}>{articleTitle}</a></p>}
      <h2 class="h3">其他{section.name}</h2>
      <ul class="sibs">{others.map((s) => <li><a href={`${section.path}/${s.slug}`}>{s.short}</a></li>)}</ul>
      {related && (
        <>
          <h2 class="h3 rel-h">{related.name}</h2>
          <ul class="sibs">{related.items.map((s) => <li><a href={`${related.path}/${s.slug}`}>{s.short}</a></li>)}</ul>
        </>
      )}
    </div>
  </section>
  <Cta />
</Base>
<style>
  .crumb { font-size: .88rem; color: var(--ink-3); margin-bottom: 20px; }
  .crumb a { color: var(--ink-3); }
  .h3 { font-family: var(--sans); font-size: 1.15rem; margin-bottom: .35em; color: var(--heading); }
  .more { font-weight: 600; margin-bottom: 28px; }
  .sibs { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sibs a { display: inline-block; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); text-decoration: none; font-size: .92rem; }
  .sibs a:hover { border-color: var(--brand); }
  .sibs-top { margin-top: 18px; }
  .sibs-label { display: block; font-size: .88rem; color: var(--ink-3); margin-bottom: 8px; }
  .rel-h { margin-top: 28px; }
  .day { padding-left: 1.4em; display: grid; gap: 10px; color: var(--ink-2); max-width: 46em; }
  .day li::marker { color: var(--brand); font-weight: 700; }
</style>

---
// 角色、診所類型、知識庫的列表頁
import Base from '../layouts/Base.astro';
import Cta from './Cta.astro';
import { breadcrumb } from '../data/schema';

interface Props {
  title: string; description: string; eyebrow: string; path: string; lead: string;
  items: { href: string; title: string; body: string }[];
}
const { title, description, eyebrow, path, lead, items } = Astro.props;
---
<Base title={title} description={description} jsonld={[breadcrumb([{ name: eyebrow, path }])]}>
  <header class="page-head">
    <div class="wrap">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </div>
  </header>
  <section class="section tight" style="padding-top:0">
    <div class="wrap">
      <div class="grid c2">
        {items.map((i) => <a class="card link-card" href={i.href}><h2 class="h3">{i.title}</h2><p>{i.body}</p></a>)}
      </div>
    </div>
  </section>
  <Cta />
</Base>
<style>
  .link-card { text-decoration: none; transition: border-color .2s, transform .2s; }
  .link-card:hover { border-color: var(--brand); transform: translateY(-2px); }
  .h3 { font-family: var(--sans); font-size: 1.15rem; margin-bottom: .35em; color: var(--heading); }
</style>
